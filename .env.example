# Mercury2 — Cortex tier, diffusion + reasoning LLM (canonical env prefix: MERCURY2_*,
# shared with platform/.env.example — ONE name set across Python and TypeScript)
# Model `mercury-2` verified live 2026-09-09 (mercury-coder-small is account-gated).
MERCURY2_API_KEY=
# MERCURY2_ENDPOINT=https://api.inceptionlabs.ai/v1/chat/completions
# MERCURY2_MODEL=mercury-2

# Cloudflare R2 (S3-compatible)
# Endpoint only — put ACCESS_KEY_ID / SECRET in .env.local, never commit
R2_S3_ENDPOINT=https://fb298783502db03eb74a63b9b6b6f69f.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Hugging Face — vendor/input boundary (Standard §6; refs/huggingface_hub/PROVENANCE.md)
# Optional: unauthenticated works for public repos (rate-limited). Set a token
# for higher rate limits and gated/private repos. Read by huggingface_hub
# (`vendor-hf` engine command) — do not rename.
# HF_TOKEN=hf_xxx
