# ── Agent-X Environment Variables ──────────────────────────────
# Copy to .env and fill in values. Do NOT commit .env.

# ── Help Assembly Business ──
COMPANY_NAME=Help Assembly Services LLC
SERVICE_AREA=Metro Atlanta
BUSINESS_PHONE=+14044391350

# ── Mercury (Inception Labs) ──
MERCURY_API_KEY=your-key-here
MERCURY_API_URL=https://api.inceptionlabs.ai/v1/chat/completions
MERCURY_MODEL=mercury-2

# ── Server Ports ──
PORT=7474
APPLESS_PORT=7475
UI_PORT=8080

# ── SMS Bridge ──
SMS_SEEN_FILE=~/Agent-X/sms_seen.txt
SMS_POLL_INTERVAL=5
AGENT_X_URL=http://127.0.0.1:7474
APPLESS_URL=http://127.0.0.1:7476

# ── Corpus Training ──
CORPUS_EXAMPLES_PER_SECTION=50
CORPUS_BUDGET_TOKENS=200000

# ── GitBook Wiki Sync ──
GITBOOK_API_TOKEN=your-gitbook-token-here
GITBOOK_ORG_ID=your-org-id
GITBOOK_SPACE_ID=your-space-id
